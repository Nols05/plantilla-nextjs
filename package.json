    "cnfast": "^0.1.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "prisma": "^7.9.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
